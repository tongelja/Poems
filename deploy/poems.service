[Unit]
Description=Poems web app
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/Poems/web
ExecStart=/home/pi/.local/bin/uv run --no-sync gunicorn --workers 2 --bind 0.0.0.0:5056 --access-logfile - poemsApp:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
